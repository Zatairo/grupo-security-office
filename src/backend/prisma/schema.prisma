generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  name                String
  password            String
  isActive            Boolean              @default(true)
  roles               UserRole[]
  auditLogs           AuditLog[]
  assignments         Assignment[]
  createdListas       Lista[]              @relation("ListaCreator")
  updatedListas       Lista[]              @relation("ListaUpdater")
  responsibleListas   Lista[]              @relation("ListaResponsible")
  supplierEvaluations SupplierEvaluation[]
  purchaseOrders      PurchaseOrder[]
  publishedProducts   Product[]            @relation("ProductPublishedBy")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("users")
}

model Assignment {
  id           String   @id @default(uuid())
  userId       String
  roleId       String?
  resourceType String
  resourceId   String
  level        String   @default("view")
  isActive     Boolean  @default(true)
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role         Role?    @relation("RoleAssignments", fields: [roleId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, resourceType, resourceId])
  @@index([resourceType, resourceId])
  @@index([userId])
  @@index([roleId])
  @@map("assignments")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       UserRole[]
  assignments Assignment[]     @relation("RoleAssignments")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model UserRole {
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  role      Role     @relation(fields: [roleId], references: [id])
  roleId    String
  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  role       Role     @relation(fields: [roleId], references: [id])
  roleId     String
  permission String
  createdAt  DateTime @default(now())

  @@id([roleId, permission])
  @@map("role_permissions")
}

model Lista {
  id                String    @id @default(uuid())
  code              String    @unique
  codigo            String?   @unique
  name              String
  description       String?
  type              String?
  defaultVisibility Boolean   @default(false)
  currency          String    @default("COP")
  isActive          Boolean   @default(true)
  archivedAt        DateTime?
  createdById       String?
  updatedById       String?
  responsibleId     String?
  supplierId        String?
  validFrom         DateTime?
  validUntil        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  creator     User?     @relation("ListaCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updater     User?     @relation("ListaUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  responsible User?     @relation("ListaResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  supplier    Supplier? @relation("ListaSupplier", fields: [supplierId], references: [id], onDelete: SetNull)

  products Product[]
  prices   Price[]

  @@index([isActive])
  @@index([archivedAt])
  @@index([responsibleId])
  @@index([supplierId])
  @@map("listas")
}

model Product {
  id              String         @id @default(uuid())
  sku             String         @unique
  name            String
  description     String?
  categoryId      String
  brandId         String
  listaId         String?
  technicalSpecs  Json?
  extraAttributes Json?
  documents       Json?
  isActive        Boolean        @default(false)
  isVisible       Boolean        @default(false)
  publishStatus   String         @default("borrador")
  publishedAt     DateTime?
  publishAt       DateTime?
  unpublishAt     DateTime?
  publishedById   String?
  unpublishReason String?
  lifecycleStatus String         @default("DRAFT")
  category        Category       @relation(fields: [categoryId], references: [id])
  brand           Brand          @relation(fields: [brandId], references: [id])
  lista           Lista?         @relation(fields: [listaId], references: [id])
  publishedBy     User?          @relation("ProductPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  prices          Price[]
  images          ProductImage[]
  auditLogs       AuditLog[]
  stock           Stock?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([listaId])
  @@index([publishStatus])
  @@index([publishAt])
  @@index([unpublishAt])
  @@index([isActive, isVisible])
  @@index([lifecycleStatus])
  @@map("products")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  description String?
  slug        String     @unique
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  logo        String?
  description String?
  website     String?
  products    Product[]
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("brands")
}

enum ProductImageType {
  PORTADA
  LOGO
  PRINCIPAL
  COMPLEMENTARIA
  EXTRA
}

model ProductImage {
  id        String            @id @default(uuid())
  productId String
  product   Product           @relation(fields: [productId], references: [id])
  url       String
  alt       String?
  type      ProductImageType  @default(PRINCIPAL)
  isPrimary Boolean           @default(false)
  sortOrder Int               @default(0)

  @@index([productId])
  @@map("product_images")
}

model PriceList {
  id         String    @id @default(uuid())
  name       String
  code       String    @unique
  currency   String    @default("COP")
  isActive   Boolean   @default(true)
  validFrom  DateTime?
  validUntil DateTime?
  prices     Price[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("price_lists")
}

model Price {
  id          String    @id @default(uuid())
  productId   String
  priceListId String
  listaId     String?
  product     Product   @relation(fields: [productId], references: [id])
  priceList   PriceList @relation(fields: [priceListId], references: [id])
  lista       Lista?    @relation(fields: [listaId], references: [id])
  value       Decimal   @db.Decimal(12, 2)
  currency    String    @default("COP")
  validFrom   DateTime?
  validUntil  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([productId, priceListId])
  @@index([productId])
  @@index([priceListId])
  @@index([listaId])
  @@map("prices")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  action    String
  entity    String
  entityId  String
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([productId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ImportMapping {
  id        String   @id @default(uuid())
  name      String
  mappings  Json
  userId    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("import_mappings")
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  nit       String   @unique
  contact   Json?
  category  String
  status    String   @default("active")
  rating    Decimal? @db.Decimal(3, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evaluations    SupplierEvaluation[]
  purchaseOrders PurchaseOrder[]
  listas         Lista[]              @relation("ListaSupplier")

  @@index([status])
  @@index([category])
  @@map("suppliers")
}

model SupplierEvaluation {
  id            String   @id @default(uuid())
  supplierId    String
  evaluatedById String?
  date          DateTime @default(now())
  criteria      Json
  score         Decimal  @db.Decimal(5, 2)
  observations  String?
  createdAt     DateTime @default(now())

  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  evaluatedBy User?    @relation(fields: [evaluatedById], references: [id], onDelete: SetNull)

  @@index([supplierId])
  @@index([evaluatedById])
  @@map("supplier_evaluations")
}

model Stock {
  id           String   @id @default(uuid())
  productId    String   @unique
  availableQty Int      @default(0)
  reservedQty  Int      @default(0)
  location     String?
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("stocks")
}

model PurchaseOrder {
  id            String   @id @default(uuid())
  code          String   @unique
  supplierId    String
  status        String   @default("requested")
  requestedById String?
  items         Json
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  requestedBy User?    @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([supplierId])
  @@index([status])
  @@index([requestedById])
  @@map("purchase_orders")
}
