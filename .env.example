# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here

# Canales Discord (IDs numéricos)
CHANNEL_SALA_OPERACIONES=
CHANNEL_ARQUITECTURA=
CHANNEL_DEV=
CHANNEL_CONTENIDO=
CHANNEL_QA=

# OpenRouter — rutas ZDR
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelos ZDR (verificar precios en openrouter.ai antes de producción)
MODEL_MISTRAL=mistralai/mistral-small-2603
MODEL_QWEN=qwen/qwen3.6-35b-a3b
MODEL_AUTO_PRIMARY=mistralai/mistral-small-2603
MODEL_AUTO_FALLBACK=qwen/qwen3.6-35b-a3b

# Memoria
MEMORY_DB_PATH=data/memory.db
MEMORY_MAX_CONTEXT_TOKENS=4096
MEMORY_RETENTION_DAYS=90

# Seguridad
MAX_DELEGATION_DEPTH=3
MAX_TOKENS_PER_REQUEST=2048
ZDR_ENABLED=true
ZDR_LOG_SANITIZATION=true

# Entorno
ENV=development
LOG_LEVEL=INFO
LOG_FILE=data/office.log
